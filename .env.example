# Copy this file to .env and edit it. .env is never committed to git.
# Every line is optional except the AWS part when you use docker-compose.aws.yml.

# ---------- Both modes ----------
# Folder with your documents (PDF, DOCX, CSV, TXT, MD). Any folder on this machine.
# The Dockerfile copies it into the image, so rebuild (up --build) when it changes.
# DOCS_DIR=./data
# Port of the web page on this machine.
# PORT=8000
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=150
# TOP_K=6

# ---------- Local mode (docker-compose.local.yml) ----------
# Any model from https://ollama.com/library. Default: qwen3.5:4b (qwen3.5:9b with the GPU file).
# LLM_MODEL=qwen3.5:4b
# EMBED_MODEL=bge-m3
# "Thinking" mode of Qwen 3.x. Leave it empty for models that do not have one (e.g. llama3.2).
# THINKING=false
# NUM_CTX=8192

# ---------- AWS mode (docker-compose.aws.yml) ----------
# AWS_REGION=us-east-1

# Required. A model ID or inference profile ID from the Bedrock model pages
# (https://docs.aws.amazon.com/bedrock/latest/userguide/model-cards.html). Examples:
#   us.anthropic.claude-haiku-5-5       Claude Haiku 5.5 (fast, low cost)
#   us.anthropic.claude-sonnet-5-5      Claude Sonnet 5.5
#   us.amazon.nova-2-lite-v1:0          Amazon Nova 2 Lite
#   qwen.qwen3-32b-v1:0                 Qwen3 32B
# The "us." prefix is a US inference profile; use "eu." or "global." for other Regions.
# BEDROCK_LLM_MODEL=us.anthropic.claude-haiku-5-5

# Embedding model. Default: amazon.titan-embed-text-v2:0. Alternative: cohere.embed-multilingual-v3
# BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
# Leave unset to use the model's default; some models reject a temperature.
# BEDROCK_TEMPERATURE=0

# Credentials: either keys...
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# ...or a profile from your AWS config folder (then also uncomment the .aws line
# in docker-compose.aws.yml).
# AWS_PROFILE=default
